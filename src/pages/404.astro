---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import "../styles/splash.css";
import "../styles/notfound.css";
---

<StarlightPage
  frontmatter={{
    title: "404 — Allfeat Docs",
    description: "The page you're looking for could not be found.",
    template: "splash",
    pagefind: false,
    tableOfContents: false,
  }}
>
  <main class="af-notfound">
    <div class="af-notfound__inner">
      <span class="af-notfound__eyebrow">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        Page not found
      </span>
      <div class="af-notfound__code">404<span class="dot">.</span></div>
      <h1 class="af-notfound__title">We couldn't find that page.</h1>
      <p class="af-notfound__sub">
        The link may be stale, or the page may have moved. Head back home, jump straight to the ATS
        overview, or use search.
      </p>
      <div class="af-notfound__actions">
        <a class="af-btn af-btn-primary" href="/">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12 12 3l9 9"/><path d="M5 10v10h14V10"/></svg>
          Back to docs home
        </a>
        <a class="af-btn af-btn-secondary" href="/ats/">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          ATS Overview
        </a>
      </div>

      <div class="af-notfound__trace">
        <div>
          <div class="label">Request</div>
          <div style="margin-top: 4px;">
            <span style="color: var(--af-accent-neg);">GET</span>
            <span id="af-404-path">/page-not-found</span>
            → <span style="color: var(--af-accent-neg);">404</span>
          </div>
        </div>
        <span class="kbd">no route</span>
      </div>
    </div>
  </main>
</StarlightPage>

<script is:inline>
  const el = document.getElementById("af-404-path");
  if (el && typeof window !== "undefined") {
    el.textContent = window.location.pathname;
  }
</script>
